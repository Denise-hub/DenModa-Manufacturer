rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is the primary admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'denmoda.handmadeshoes@gmail.com';
    }

    // Public collections read permissions
    match /hero/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /about/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /services/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /products/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /pricing/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /team/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /contact/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /faq/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /iconBoxes/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /siteSettings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Messages collection - Anyone can submit contact form
    match /messages/{document=**} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    // Orders collection - Anyone can place an order
    match /orders/{document=**} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    // Analytics collection - Anyone can log page views
    match /analytics/{document=**} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
